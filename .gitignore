# Build output: only the flashable images are tracked (see docs/flashing-new-device.md).
# Everything else in build/ (objects, .elf, .map, caches) is regenerated by tools/build.sh.
build/*
!build/aicc_phone.ino.bin
!build/aicc_phone.ino.bootloader.bin
!build/aicc_phone.ino.partitions.bin
!build/boot_app0.bin
!build/aicc_phone.ino.merged.bin
aicc_phone/build/
*.bin.tmp
.DS_Store
*.log
